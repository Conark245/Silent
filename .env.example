# Required for Vercel (To prevent data loss since Vercel is Serverless)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/obs_donation_db"

# Cloudinary Integration (Required on Vercel for Image/Media Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin Authentication (Optional: Defaults to admin / admin123)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
SESSION_SECRET="super-secret-key-change-in-production"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_IDS=""

